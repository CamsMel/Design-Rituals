# ---- Claude, via le proxy GenAI Thiga (models.thiga.co) --------------------
# Clé personnelle reçue par message privé Slack (#help-genai-platform).
# Utilisée comme Bearer token, pas comme clé Anthropic directe.
ANTHROPIC_BASE_URL=https://models.thiga.co
ANTHROPIC_AUTH_TOKEN=sk-...
ANTHROPIC_MODEL=claude-sonnet-5

# ---- Accès ------------------------------------------------------------------
# Pas de SSO Google pour l'instant (accès Google Cloud manquant côté humain).
# Un seul mot de passe partagé, demandé par le navigateur en Basic Auth.
# Les consultants tapent leur email en "username" : c'est ce nom qui apparaît
# sur la cover du deck, rien ne le vérifie.
APP_PASSWORD=change-me
PUBLIC_BASE_URL=https://tribe-prep.up.railway.app

# Any long random string. `openssl rand -hex 32`
SESSION_SECRET=change-me

# ---- Google Drive (service account) ---------------------------------------
# Contents of the service-account JSON key, on ONE line.
# Leave empty to disable the Drive button: the download still works.
GOOGLE_SERVICE_ACCOUNT_JSON=
# ID of the shared folder, taken from its URL after /folders/
DRIVE_FOLDER_ID=

# ---- Limits ----------------------------------------------------------------
MAX_TURNS=30
MAX_BUDGET_USD=2.0
