# ---- Claude, via le proxy GenAI Thiga (models.thiga.co) --------------------
# Clé personnelle reçue par message privé Slack (#help-genai-platform).
# Utilisée comme Bearer token, pas comme clé Anthropic directe.
ANTHROPIC_BASE_URL=https://models.thiga.co
ANTHROPIC_AUTH_TOKEN=sk-...
ANTHROPIC_MODEL=claude-sonnet-5

# ---- Accès ------------------------------------------------------------------
# Aucune authentification : app ouverte, décision assumée. Claude demande le
# nom du consultant dans la conversation elle-même (voir agent.py).
PUBLIC_BASE_URL=https://tribe-prep.up.railway.app

# Any long random string. `openssl rand -hex 32`
SESSION_SECRET=change-me

# ---- Google Drive (service account) ---------------------------------------
# Contents of the service-account JSON key, on ONE line.
# Leave empty to disable the Drive button: the download still works.
GOOGLE_SERVICE_ACCOUNT_JSON=
# ID of the shared folder, taken from its URL after /folders/
DRIVE_FOLDER_ID=

# ---- Limits ----------------------------------------------------------------
MAX_TURNS=30
MAX_BUDGET_USD=2.0
